{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "height": 500,
  "width": "container",
  "autosize": {"type": "fit", "contains": "padding"},
  "title": "Human Development Index vs Labour Productivity",
  "params": [
    {
      "name": "selectedYear",
      "value": 2022,
      "bind": {
        "input": "range",
        "step": 1,
        "min": 1990,
        "max": 2022,
        "name": "Select Year: "
      }
    },
    {
      "name": "selectedRegion",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "Asia", "Europe", "Africa", "Americas", "Oceania"],
        "name": "Select Region: "
      }
    }
  ],
  "data": {"url": "data/hdi_int_prod.csv", "format": {"type": "csv"}},
  "transform": [
    {"filter": "datum.Year == selectedYear"},
    {"filter": "selectedRegion == 'All' || datum.region == selectedRegion"},
    {"filter": "datum.Productivity != 0"}
  ],
  "mark": {"type": "point", "filled": true, "opacity": 0.7},
  "encoding": {
    "x": {"field": "Productivity", "type": "quantitative", "title": "Productivity (output per hour worked)", "scale": {"domain": [0, 180]}},
    "y": {"field": "Human Development Index", "type": "quantitative", "scale": {"domain": [0.2, 1]}},
    "size": {"field": "Internet", "type": "quantitative", "title": "Individuals using the Internet (%)", "scale": {"range": [5,350]}},
    "color": {"field": "region", "type": "nominal", "title": "World regions"},
    "tooltip": [
      {"field": "Entity", "type": "nominal", "title": "Country"},
      {"field": "Human Development Index", "type": "quantitative", "title": "Human Development Index"},
      {"field": "Productivity", "type": "quantitative", "title": "Productivity (output per hour worked)"},
      {"field": "Internet", "type": "quantitative", "title": "Individuals using the Internet (% of population)"}
    ]
  }
}
