{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Basic scatter plot of GDP per capita vs Percentage of Households with a Computer in 2023",
  "title": "GDP per Capita vs Percentage of Households with a Computer in 2023",
  "height": "container",
  "width": "container",
  "autosize": {"type": "fit", "contains": "padding"},
  "params": [
    {
      "name": "selectedRegion",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All", "Asia", "Europe", "Africa", "Americas", "Oceania"],
        "name": "Select Region: "
      }
    }
  ],
  "layer": [
    {
      "data": {
          "url": "data/gdp-per-capita-worldbank.csv",
          "format": {"type": "csv"}
        },
        "transform": [
          {"filter": "toNumber(datum.Year) == 2023 && datum['GDP per capita, PPP (constant 2021 international $)'] != 0"},
          {
            "lookup": "Code",
            "from": {
                "data": {
                    "url": "data/ITU_DH_HH_COMP.csv",
                    "format": { "type": "csv" }
                },
                "key": "REF_AREA",
                "fields": ["OBS_VALUE"]
            }
          },
          {
            "lookup": "Code",
            "from": {
                "data": {
                    "url": "data/continents2.csv",
                    "format": {"type": "csv"}
                },
                "key": "alpha-3",
                "fields": ["region"]
            }
          },
          {"filter": "selectedRegion == 'All' || datum.region == selectedRegion"}
        ],
        "mark": {
            "type": "point",
            "filled": true,
            "opacity": 0.7
        },
        "encoding": {
          "x": {
              "field": "GDP per capita, PPP (constant 2021 international $)",
              "type": "quantitative",
              "title": "GDP per capita, PPP (constant 2021 international $)"
          },
          "y": {
            "field": "OBS_VALUE",
            "type": "quantitative",
            "title": "% of Households with a Computer"
          },
          "color": {"field": "region", "type": "nominal", "title": "World regions"},
          "tooltip": [
            {"field": "Entity", "type": "nominal", "title": "Country"},
            {"field": "GDP per capita, PPP (constant 2021 international $)", "format": ",.2f"},
            {"field": "OBS_VALUE", "format": ".2f", "title": "% of Population with a Computer"}
          ]
        }
    },
    {
      "data": {
          "url": "data/gdp-per-capita-worldbank.csv",
          "format": {"type": "csv"}
        },
        "transform": [
          {"filter": "toNumber(datum.Year) == 2023 && datum['GDP per capita, PPP (constant 2021 international $)'] != 0"},
          {"filter": "selectedRegion == 'All' || datum.region == selectedRegion"},
          {
            "lookup": "Code",
            "from": {
                "data": {
                    "url": "data/ITU_DH_HH_COMP.csv",
                    "format": { "type": "csv" }
                },
                "key": "REF_AREA",
                "fields": ["OBS_VALUE"]
            }
          },
          {
            "lookup": "Code",
            "from": {
                "data": {
                    "url": "data/continents2.csv",
                    "format": {"type": "csv"}
                },
                "key": "alpha-3",
                "fields": ["region"]
            }
          },
          {"regression": "GDP per capita, PPP (constant 2021 international $)", "on": "OBS_VALUE"}
        ],
        "mark": {"type": "line", "color": "grey", "strokeDash": [2, 2]},
        "encoding": {
          "x": {
              "field": "GDP per capita, PPP (constant 2021 international $)",
              "type": "quantitative",
              "title": "GDP per capita, PPP (constant 2021 international $)"
          },
          "y": {
            "field": "OBS_VALUE",
            "type": "quantitative",
            "title": "% of Households with a Computer"
          },
          "tooltip": [
            {"field": "Entity", "type": "nominal", "title": "Country"},
            {"field": "GDP per capita, PPP (constant 2021 international $)", "format": ".2f"},
            {"field": "OBS_VALUE", "format": ".2f", "title": "% of Population with a Computer"}
          ]
        }
    }
  ]
}