{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": "container",
    "height": 500,
    "autosize": {"type": "fit", "contains": "padding"},
    "title": {"text": "Growth of ICT Exports and GDP"},
    "params": [
        {
            "name": "selectedCountry",
            "value": "Malaysia",
            "bind": {
                "input": "select",
                "options": [
                    "Australia",
                    "Brazil",
                    "Canada",
                    "Chile",
                    "China",
                    "France",
                    "Germany",
                    "India",
                    "Italy",
                    "Japan",
                    "Malaysia",
                    "Mexico",
                    "Netherlands",
                    "Norway",
                    "Poland",
                    "Singapore",
                    "South Korea",
                    "Sweden",
                    "United Kingdom",
                    "United States"
                ],
                "name": "Select Country: "
            }
        }
    ],
    "layer": [
        {
            "data": {"values": [{"year": "2008", "text": "2008 Financial Crisis"}]},
            "mark": {"type": "text", "angle": -90, "dy": -10, "dx": 5, "color": "grey"},
            "encoding": {
                "x": {"field": "year", "type": "ordinal"},
                "y": {"value": 200},
                "text": {"field": "text"}
            }
        },
        {
            "data": {"values": [{"year": 2008}]},
            "mark": {
                "type": "rule",
                "color": "gray",
                "strokeWidth": 2,
                "strokeDash": [4, 4],
                "opacity": 0.4
            },
            "encoding": {
                "x": {"field": "year", "type": "ordinal"}
            }
        },
        {
            "data": {"values": [{"year": "2020", "text": "COVID-19 Pandemic"}]},
            "mark": {"type": "text", "angle": -90, "dy": -10, "dx": 5, "color": "grey"},
            "encoding": {
                "x": {"field": "year", "type": "ordinal"},
                "y": {"value": 200},
                "text": {"field": "text"}
            }
        },
        {
            "data": {"values": [{"year": 2020}]},
            "mark": {
                "type": "rule",
                "color": "gray",
                "strokeWidth": 2,
                "strokeDash": [4, 4],
                "opacity": 0.4
            },
            "encoding": {
                "x": {"field": "year", "type": "ordinal"}
            }
        },
        {
            "data": {
                "url": "data/ict-export.csv",
                "format": {"type": "csv"}
            },
            "transform": [
                {"filter": "datum.INDICATOR == 'DDS'"},
                {"filter": "datum.FLOW == 'X'"},
                {"filter": "datum.REPORTER_NAME == selectedCountry"},
                {
                    "window": [{"op":"lag", "field": "VALUE", "as": "baseline_users"}],
                    "sort": [{"field": "YEAR"}]
                },
                {
                    "calculate": "datum.baseline_users > 0 ? (datum.VALUE - datum.baseline_users) / datum.baseline_users : 0",
                    "as": "percentage_growth"
                },
                {
                    "calculate": "'ICT Exports'",
                    "as": "metric"
                }
            ],
            "mark": {
                "type": "area",
                "opacity": 0.15
            },
            "encoding": {
                "x": {"field": "YEAR", "type": "ordinal", "title": "Year"},
                "y": {
                    "field": "percentage_growth",
                    "type": "quantitative",
                    "axis": {
                        "format": ".0%",
                        "title": "Growth"
                    }
                },
                "color": {
                    "field": "metric",
                    "type": "nominal",
                    "title": "Metric",
                    "scale": {
                        "domain": ["ICT Exports", "GDP Growth"],
                        "range": ["#4c78a8", "#f58518"]
                    }
                }
            }
        },
        {
            "data": {
                "url": "data/ict-export.csv",
                "format": {"type": "csv"}
            },
            "transform": [
                {"filter": "datum.INDICATOR == 'DDS'"},
                {"filter": "datum.FLOW == 'X'"},
                {"filter": "datum.REPORTER_NAME == selectedCountry"},
                {
                    "window": [{"op":"lag", "field": "VALUE", "as": "baseline_users"}],
                    "sort": [{"field": "YEAR"}]
                },
                {
                    "calculate": "datum.baseline_users > 0 ? (datum.VALUE - datum.baseline_users) / datum.baseline_users : 0",
                    "as": "percentage_growth"
                },
                {
                    "calculate": "'ICT Exports'",
                    "as": "metric"
                }
            ],
            "mark": {
                "type": "line",
                "strokeDash": [2,2]
            },
            "encoding": {
                "x": {"field": "YEAR", "type": "ordinal", "title": "Year"},
                "y": {
                    "field": "percentage_growth",
                    "type": "quantitative",
                    "axis": {
                        "format": ".0%",
                        "title": "Growth"
                    }
                },
                "color": {
                    "field": "metric",
                    "type": "nominal",
                    "title": "Metric",
                    "scale": {
                        "domain": ["ICT Exports", "GDP Growth"],
                        "range": ["#4c78a8", "#f58518"]
                    }
                }
            }
        },
        {
            "data": {
                "url": "data/ict-export.csv",
                "format": {"type": "csv"}
            },
            "transform": [
                {"filter": "datum.INDICATOR == 'DDS'"},
                {"filter": "datum.FLOW == 'X'"},
                {"filter": "datum.REPORTER_NAME == selectedCountry"},
                {
                    "window": [{"op":"lag", "field": "VALUE", "as": "baseline_users"}],
                    "sort": [{"field": "YEAR"}]
                },
                {
                    "calculate": "datum.baseline_users > 0 ? (datum.VALUE - datum.baseline_users) / datum.baseline_users : 0",
                    "as": "percentage_growth"
                },
                {
                    "calculate": "'ICT Exports'",
                    "as": "metric"
                }
            ],
            "mark": {
                "type": "point",
                "filled": true,
                "opacity": 1
            },
            "encoding": {
                "x": {"field": "YEAR", "type": "ordinal", "title": "Year"},
                "y": {
                    "field": "percentage_growth",
                    "type": "quantitative",
                    "axis": {
                        "format": ".0%",
                        "title": "Growth"
                    }
                },
                "color": {
                    "field": "metric",
                    "type": "nominal",
                    "title": "Metric",
                    "scale": {
                        "domain": ["ICT Exports", "GDP Growth"],
                        "range": ["#4E79A7", "#F28E2B"] 
                    }
                },
                "tooltip": [
                    {"field": "YEAR", "type": "ordinal", "title": "Year"},    
                    {"field": "VALUE", "type": "quantitative", "title": "ICT Exports (million US dollars)", "format": ",.2f"}              
                ]   
            }
        },
        {
            "data": {
                    "url": "data/gdp.csv",
                    "format": {"type": "csv"}
            },
            "transform": [
                {"filter": "datum['Country Name'] == selectedCountry"},
                {"fold": ["1960","1961","1962","1963","1964","1965","1966","1967","1968","1969","1970","1971","1972","1973","1974","1975","1976","1977","1978","1979","1980","1981","1982","1983","1984","1985","1986","1987","1988","1989","1990","1991","1992","1993","1994","1995","1996","1997","1998","1999","2000","2001","2002","2003","2004","2005","2006","2007","2008","2009","2010","2011","2012","2013","2014","2015","2016","2017","2018","2019","2020","2021","2022","2023","2024"],
                    "as": ["Year", "GDP"]
                },
                {"filter": "datum.Year >= 2005"},                
                {
                    "window": [{"op":"lag", "field": "GDP", "as": "previous_gdp"}],
                    "sort": [{"field": "Year"}]
                },
                {
                    "calculate": "datum.previous_gdp > 0 ? (datum.GDP - datum.previous_gdp) / datum.previous_gdp : 0",
                    "as": "percentage_growth"
                },
                {
                    "calculate": "'GDP Growth'",
                    "as": "metric"
                }
            ],
            "mark": {"type": "line"},
            "encoding": {
                "x": {"field": "Year", "type": "ordinal", "title": "Year"},
                "y": {
                    "field": "percentage_growth",
                    "type": "quantitative",
                    "axis": {
                        "format": ".0%",
                        "title": "Growth"
                    }
                },
                "color": {
                    "field": "metric",
                    "type": "nominal",
                    "title": "Metric",
                    "scale": {
                        "range": ["#4E79A7", "#F28E2B"] 
                    },
                        "legend": {
                        "symbolType": "circle",
                        "symbolSize": 200
                    }
                }
            }
        },
        {
            "data": {
                    "url": "data/gdp.csv",
                    "format": {"type": "csv"}
            },
            "transform": [
                {"filter": "datum['Country Name'] == selectedCountry"},
                {"fold": ["1960","1961","1962","1963","1964","1965","1966","1967","1968","1969","1970","1971","1972","1973","1974","1975","1976","1977","1978","1979","1980","1981","1982","1983","1984","1985","1986","1987","1988","1989","1990","1991","1992","1993","1994","1995","1996","1997","1998","1999","2000","2001","2002","2003","2004","2005","2006","2007","2008","2009","2010","2011","2012","2013","2014","2015","2016","2017","2018","2019","2020","2021","2022","2023","2024"],
                    "as": ["Year", "GDP"]
                },
                {"filter": "datum.Year >= 2005"},                  
                {
                    "window": [{"op":"lag", "field": "GDP", "as": "previous_gdp"}],
                    "sort": [{"field": "Year"}]
                },
                {
                    "calculate": "datum.previous_gdp > 0 ? (datum.GDP - datum.previous_gdp) / datum.previous_gdp : 0",
                    "as": "percentage_growth"
                },
                {
                    "calculate": "'GDP Growth'",
                    "as": "metric"
                }
            ],
            "mark": {
                "type": "point",
                "filled": true,
                "opacity": 1
            },
            "encoding": {
                "x": {"field": "Year", "type": "ordinal", "title": "Year"},
                "y": {
                    "field": "percentage_growth",
                    "type": "quantitative",
                    "axis": {
                        "format": ".0%",
                        "title": "Growth"
                    }
                },
                "color": {
                    "field": "metric",
                    "type": "nominal",
                    "title": "Metric"
                },
                "tooltip": [
                    {"field": "Year", "type": "ordinal", "title": "Year"},    
                    {"field": "GDP", "type": "quantitative", "title": "GDP (US dollars)", "format": ",.2f"}        
                ]   
            }
        }
    ]
}