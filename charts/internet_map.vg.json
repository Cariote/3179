{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": "container",
    "height": 400,
    "autosize": {"type": "fit", "contains": "padding"},
    "title": {"text": "Worldwide Internet Usage"},
    "data": {
        "url": "data/ne_110m.json",
        "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
    },  
    "projection": {"type": "equalEarth"},
    "params": [
        {
        "name": "selectedYear",
        "value": 2020,
        "bind": {
            "input": "range",
            "min": 1990,
            "max": 2022,
            "step": 1,
            "name": "Select Year:"
        }
        }
    ],
    "layer": [
        {
            "data": {"sphere": {}},
            "mark": {"type": "geoshape", "fill": "#a6cee3", "stroke": null}
        },
        {
            "mark": {"type": "geoshape", "fill": "#d9d9d9", "stroke": "black", "strokeWidth": 0.1},
              "transform": [
                {"calculate": "selectedYear", "as": "SelectedYear"},
                {"calculate": "'No data'", "as": "GDP"}
            ],
            "encoding": {
                "tooltip": [
                    {"field": "properties.NAME", "type": "nominal", "title": "Country"},
                    {"field": "GDP", "title": "GDP per Capita"},
                    {"field": "SelectedYear", "title": "Year"}   
                ]
            }
        },
        {
            "data": {
                    "url": "data/internet.csv",
                    "format": {"type": "csv"}
                },
                "transform": [
                    {"filter": "toNumber(datum.Year) == selectedYear"},
                    {
                        "lookup": "Code",
                        "from": {
                            "data": {
                                "url": "data/ne_110m.json",
                                "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
                            },
                            "key": "properties.ISO_A3_EH",
                            "fields": ["properties", "type", "geometry"]
                        }
                    },
                    {
                        "calculate": "datum['Individuals using the Internet (% of population)'] == 0 || datum['Individuals using the Internet (% of population)'] == null ? 'No data' : datum['Individuals using the Internet (% of population)']",
                        "as": "DisplayValue"
                    }
                ],
                "mark": {"type": "geoshape", "stroke": "black", "strokeWidth": 0.1, "invalid": "show"},
                "encoding": {
                    "shape": {
                        "field": "geometry",
                        "type": "geojson"
                    },
                    "color": {
                            "field": "Individuals using the Internet (% of population)",
                            "type": "quantitative",
                            "scale": {
                                    "type": "threshold",
                                    "domain": [20, 40, 60, 80],
                                    "scheme": "bluegreen"
                                },
                            "legend": {
                                "title": "% of population",
                                "gradientLength": 100,
                                "labelLimit": 40,   
                                "titleLimit": 100,   
                                "orient": "right",   
                                "padding": 0            
                            }
                    },
                "tooltip": [
                    {"field": "Entity", "type": "nominal", "title": "Country"},
                    {"field": "Individuals using the Internet (% of population)", "title": "GDP per Capita (PPP)", "format": ".2f"},
                    {"field": "Year", "title": "Year"}                
                ]   
            }
        },
        {
            "data": {"graticule": true},
            "mark": {"type": "geoshape", "stroke": "#959595", "strokeWidth": 0.3}
        },
        {
            "data": {
                "url": "data/ne_110m.json",
                "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
            },
            "mark": {"type": "geoshape", "fill": "transparent"},
              "transform": [
                {"calculate": "selectedYear", "as": "SelectedYear"},
                {"calculate": "'No data'", "as": "GDP"}
            ],
            "encoding": {
                "tooltip": [
                    {"field": "properties.NAME", "type": "nominal", "title": "Country"},
                    {"field": "GDP", "title": "GDP per Capita (PPP)"},
                    {"field": "SelectedYear", "title": "Year"}   
                ]
            }
        },
        {
            "data": {
                    "url": "data/internet.csv",
                    "format": {"type": "csv"}
                },
                "transform": [
                    {"filter": "toNumber(datum.Year) == selectedYear"},
                    {
                        "lookup": "Code",
                        "from": {
                            "data": {
                                "url": "data/ne_110m.json",
                                "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
                            },
                            "key": "properties.ISO_A3_EH",
                            "fields": ["properties", "type", "geometry"]
                        }
                    },
                    {
                        "calculate": "datum['Individuals using the Internet (% of population)'] == 0 || datum['Individuals using the Internet (% of population)'] == null ? 'No data' : datum['Individuals using the Internet (% of population)']",
                        "as": "DisplayValue"
                    }
                ],
                "mark": {"type": "geoshape", "fill": "transparent"},
                "encoding": {
                    "shape": {
                        "field": "geometry",
                        "type": "geojson"
                    },
                "tooltip": [
                    {"field": "Entity", "type": "nominal", "title": "Country"},
                    {"field": "Individuals using the Internet (% of population)", "title": "Individuals using the Internet (% of population)", "format": ".2f"},
                    {"field": "Year", "title": "Year"}                
                ]   
            }
        },
        {
            "data": {
                "url": "data/tiny_countries.csv"
            },
            "transform": [
                {
                    "calculate": "'No data'",
                    "as": "Individuals using the Internet (% of population)"
                },
                {
                    "calculate": "selectedYear",
                    "as": "SelectedYear"
                }
            ],
            "mark": {"type": "circle", "size": 15, "stroke": "black", "strokeWidth": 0.2, "fill": "#d9d9d9"},
            "encoding": {
                "longitude": {"field": "lon", "type": "quantitative"},
                "latitude": {"field": "lat", "type": "quantitative"},
                "tooltip": [
                    {"field": "Name", "type": "nominal", "title": "Country"},
                    {"field": "Individuals using the Internet (% of population)", "title": "Individuals using the Internet (% of population)", "format": ".2f"},
                    {"field": "SelectedYear", "title": "Year"}                
                ]
            }
        },
        {
            "data": {
                "url": "data/internet.csv"
            },
            "transform": [
                {"filter": "datum.Year == selectedYear"},
                {
                    "lookup": "Code",
                    "from": {
                        "data": {"url": "data/tiny_countries.csv"},
                        "key": "ISO_A3",
                        "fields": ["lat", "lon"]
                    }
                },
                {
                    "calculate": "datum['Individuals using the Internet (% of population)'] == 0 || datum['Individuals using the Internet (% of population)'] == null ? 'No data' : format(datum['Individuals using the Internet (% of population)'], '.2f')",
                    "as": "DisplayValue"
                },
                {
                    "calculate": "selectedYear",
                    "as": "SelectedYear"
                },
                {"filter": "datum.lon != null && datum.lat != null"}
            ],
            "mark": {"type": "circle", "size": 15, "stroke": "black", "strokeWidth": 0.2},
            "encoding": {
                "longitude": {"field": "lon", "type": "quantitative"},
                "latitude": {"field": "lat", "type": "quantitative"},
                "color": {
                    "field": "Individuals using the Internet (% of population)",
                    "type": "quantitative",
                    "scale": {
                            "type": "threshold",
                            "domain": [20, 40, 60, 80],
                            "scheme": "bluegreen"
                        },
                    "legend": {"title": "Individuals using the Internet (% of population)"}
                },
                "tooltip": [
                    {"field": "Entity", "type": "nominal", "title": "Country"},
                    {"field": "DisplayValue", "title": "Individuals using the Internet (% of population)", "format": ".2f"},
                    {"field": "SelectedYear", "title": "Year"}                
                ]
            }
        }
    ]
}