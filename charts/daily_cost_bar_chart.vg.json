{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": "container",
    "height": "container",
    "autosize": {"type": "fit", "contains": "padding"},
    "title": {"text": "Worldwide Percentage of Households with a Computer in 2023"},
    "projection": {"type": "equalEarth"},
    "layer": [
        {
        "data": {"sphere": {}},
        "mark": {"type": "geoshape", "fill": "#a6cee3", "stroke": null}
        },
        {
        "data": {
                "url": "data/ne_110m.json",
                "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
            },
            "transform": [
                {
                    "lookup": "properties.ISO_A3_EH",
                    "from": {
                        "data": {
                            "url": "https://raw.githubusercontent.com/Cariote/3179/refs/heads/homework-week9/data/ITU_DH_HH_COMP.csv"
                        },
                        "key": "REF_AREA",
                        "fields": ["OBS_VALUE"]
                    }
                },
                {
                    "calculate": "datum.OBS_VALUE == 0 || datum.OBS_VALUE == null ? 'No data' : datum.OBS_VALUE",
                    "as": "DisplayValue"
                }
            ],
            "mark": {"type": "geoshape", "stroke": "black", "strokeWidth": 0.2, "invalid": "show"},
            "encoding": {
                "color": {
                    "condition": {
                        "test": "isValid(datum.OBS_VALUE)",
                        "field": "OBS_VALUE",
                        "type": "quantitative",
                        "scale": {
                                "type": "threshold",
                                "domain": [20, 40, 60, 80],
                                "range": ["#fef0d9","#fdcc8a","#fc8d59","#e34a33","#b30000"]
                            },
                        "legend": {
                            "title": "% Households with a Computer",
                            "gradientLength": 100,
                            "labelLimit": 40,   
                            "titleLimit": 100,   
                            "orient": "right",   
                            "padding": 0              
                        }
                        },
                    "value": "#d9d9d9"
                }
        }
        },
        {
        "data": {"graticule": true},
        "mark": {"type": "geoshape", "stroke": "#959595", "strokeWidth": 0.3}
        },
        {
        "data": {
                "url": "data/ne_110m.json",
                "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
            },
            "transform": [
                {
                "lookup": "properties.ISO_A3_EH",
                "from": {
                    "data": {"url": "https://raw.githubusercontent.com/Cariote/3179/refs/heads/homework-week9/data/ITU_DH_HH_COMP.csv"},
                    "key": "REF_AREA",
                    "fields": ["OBS_VALUE"]
                }
                },
                {
                "calculate": "datum.OBS_VALUE == 0 || datum.OBS_VALUE == null ? 'No data' : datum.OBS_VALUE",
                "as": "DisplayValue"
                }
            ],
            "mark": {"type": "geoshape", "fill": "transparent", "stroke": null},
            "encoding": {
                "tooltip": [
                {"field": "properties.NAME", "type": "nominal", "title": "Country"},
                {"field": "DisplayValue", "type": "nominal", "title": "Percentage"}
                ]
            }
        },
        {
        "data": {
            "url": "https://raw.githubusercontent.com/Cariote/3179/refs/heads/homework-week9/data/tiny_countries.csv"
        },
        "transform": [
            {
            "lookup": "ISO_A3",
            "from": {
                "data": {"url": "https://raw.githubusercontent.com/Cariote/3179/refs/heads/homework-week9/data/ITU_DH_HH_COMP.csv"},
                "key": "REF_AREA",
                "fields": ["OBS_VALUE"]
            }
            },
            {
            "calculate": "datum.OBS_VALUE == 0 || datum.OBS_VALUE == null ? 'No data' : datum.OBS_VALUE",
            "as": "DisplayValue"
            }
        ],
        "mark": {"type": "circle", "size": 15, "stroke": "black", "strokeWidth": 0.5},
        "encoding": {
            "longitude": {"field": "lon", "type": "quantitative"},
            "latitude": {"field": "lat", "type": "quantitative"},
            "color": {
            "field": "OBS_VALUE",
            "type": "quantitative",
            "scale": {
                "type": "threshold",
                "domain": [20, 40, 60, 80],
                "range": ["#fef0d9","#fdcc8a","#fc8d59","#e34a33","#b30000"]
            }
            },
            "tooltip": [
            {"field": "Name", "title": "Country"},
            {"field": "DisplayValue", "title": "Percentage"}
            ]
        }
        }
    ]
}